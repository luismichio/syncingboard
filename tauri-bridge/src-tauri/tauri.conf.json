{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncingBridge",
  "version": "0.18.1",
  "identifier": "com.syncingboard.bridge",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SyncingBridge",
        "width": 480,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://www.syncingboard.com https://syncingboard.com https://*.protokoba.com https://*.ably.io wss://*.ably.io https://*.ably-realtime.com wss://*.ably-realtime.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
